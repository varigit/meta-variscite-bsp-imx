From 5deb144daf0c9c7e8f4e0e3c56e0080c0fa466ef Mon Sep 17 00:00:00 2001
From: Luan Rafael Carneiro <luan.r@variscite.com>
Date: Mon, 27 Jul 2026 09:07:40 -0300
Subject: [PATCH] uboot_env: extend line length to 4096

This avoid cutting commands longer than 1024 chars

Upstream-Status: Pending
Signed-off-by: Pierluigi Passaro <pierluigi.p@variscite.com>
Signed-off-by: FrancescoFerraro <francesco.f@variscite.com>
Signed-off-by: Alexander Herfurtner <alexander.h@variscite.com>
Signed-off-by: Luan Rafael Carneiro <luan.r@variscite.com>
---
 src/uboot_env.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/uboot_env.c b/src/uboot_env.c
index 96d23bf..ef01e08 100644
--- a/src/uboot_env.c
+++ b/src/uboot_env.c
@@ -766,7 +766,7 @@ static int libuboot_load(struct uboot_ctx *ctx)
 	return ctx->valid ? 0 : -ENODATA;
 }
 
-#define LINE_LENGTH 2048
+#define LINE_LENGTH 4096
 int libuboot_load_file(struct uboot_ctx *ctx, const char *filename)
 {
 	FILE *fp;
-- 
2.51.2


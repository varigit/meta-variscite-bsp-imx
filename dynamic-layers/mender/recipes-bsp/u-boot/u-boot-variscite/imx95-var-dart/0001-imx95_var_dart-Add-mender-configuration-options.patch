From 0efd22a04a7c2e939159e68816cd8d747560d95e Mon Sep 17 00:00:00 2001
From: Alex Lucchesi <alex.l@variscite.com>
Date: Tue, 17 Mar 2026 16:06:58 -0300
Subject: [PATCH] imx95_var_dart: Add Mender configuration options

Upstream-Status: Inappropriate [mender-specific configuration]
Signed-off-by: Alex Lucchesi <alex.l@variscite.com>
---
 configs/imx95_var_dart_defconfig | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/configs/imx95_var_dart_defconfig b/configs/imx95_var_dart_defconfig
index 1a92e0ff9a7..c811ecbb978 100644
--- a/configs/imx95_var_dart_defconfig
+++ b/configs/imx95_var_dart_defconfig
@@ -7,7 +7,7 @@ CONFIG_SPL_GPIO=y
 CONFIG_SPL_LIBCOMMON_SUPPORT=y
 CONFIG_SPL_LIBGENERIC_SUPPORT=y
 CONFIG_NR_DRAM_BANKS=3
-CONFIG_ENV_SIZE=0x4000
+CONFIG_ENV_SIZE=0x20000
 CONFIG_ENV_OFFSET=0x700000
 CONFIG_IMX_CONFIG="arch/arm/mach-imx/imx9/scmi/imximage.cfg"
 CONFIG_DM_GPIO=y
@@ -25,6 +25,7 @@ CONFIG_SPL_BSS_START_ADDR=0x204d6000
 CONFIG_SPL_BSS_MAX_SIZE=0x2000
 CONFIG_SYS_LOAD_ADDR=0x90400000
 CONFIG_SPL=y
+CONFIG_ENV_OFFSET_REDUND=0x740000
 CONFIG_SPL_RECOVER_DATA_SECTION=y
 CONFIG_ELE_SHARED_BUFFER=0x98000000
 CONFIG_EXTCON_PTN5150=y
@@ -96,10 +97,9 @@ CONFIG_CMD_EXT4_WRITE=y
 CONFIG_OF_CONTROL=y
 CONFIG_SPL_OF_CONTROL=y
 CONFIG_ENV_OVERWRITE=y
-CONFIG_ENV_IS_NOWHERE=y
 CONFIG_ENV_IS_IN_MMC=y
+CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
 CONFIG_SYS_RELOC_GD_ENV_ADDR=y
-CONFIG_SYS_MMC_ENV_DEV=1
 CONFIG_USE_ETHPRIME=y
 CONFIG_ETHPRIME="eth0"
 # CONFIG_BOOTDEV_ETH is not set
@@ -108,6 +108,8 @@ CONFIG_SYS_RX_ETH_BUFFER=8
 CONFIG_SPL_DM=y
 CONFIG_SPL_DM_SEQ_ALIAS=y
 CONFIG_SPL_OF_TRANSLATE=y
+CONFIG_BOOTCOUNT_LIMIT=y
+CONFIG_BOOTCOUNT_ENV=y
 CONFIG_SPL_CLK=y
 CONFIG_SPL_CLK_CCF=y
 CONFIG_CLK_SCMI=y
-- 
2.43.0
